# Databricks workspace URL (e.g. https://adb-123456789.azuredatabricks.net)
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net

# Authentication — choose ONE of the two options below:
#
# Option 1: Personal Access Token (PAT) — suitable for development/testing.
# Generate from Databricks UI: User Settings > Developer > Access Tokens.
DATABRICKS_TOKEN=dapi<your-personal-access-token>

# Option 2: Service Principal (recommended for CI/CD and production).
# Set DATABRICKS_TOKEN to the OAuth M2M token for the service principal.
# Also set the client credentials below when using OAuth M2M via the SDK.
# DATABRICKS_CLIENT_ID=<service-principal-application-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-secret>

# Target cluster ID (existing interactive cluster for ad-hoc runs)
DATABRICKS_CLUSTER_ID=<your-cluster-id>

# Unity Catalog environment (dev / staging / prod)
DATABRICKS_ENV=dev

# Storage account / S3 bucket root for raw data landing
BRONZE_SOURCE_PATH=abfss://raw@<storage-account>.dfs.core.windows.net/
# (S3 example: s3://your-bucket/raw/)
