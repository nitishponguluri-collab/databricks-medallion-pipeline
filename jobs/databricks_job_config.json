{
  "name": "medallion-pipeline-{{env}}",
  "description": "Orchestrates Bronze → Silver → Gold → Quality checks for the medallion architecture.",
  "tags": {
    "team": "data-platform",
    "pipeline": "medallion",
    "cost-center": "analytics"
  },
  "email_notifications": {
    "on_failure": ["data-platform@company.com"],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "slack-webhook-id"
      }
    ]
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "description": "Auto Loader ingestion from cloud storage into bronze Delta tables",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/medallion-pipeline/notebooks/01_bronze_ingestion",
        "base_parameters": {
          "env": "{{env}}",
          "source_name": "orders"
        },
        "source": "WORKSPACE"
      },
      "new_cluster": {
        "cluster_name": "bronze-cluster-{{env}}",
        "spark_version": "14.3.x-photon-scala2.12",
        "node_type_id": "Standard_DS4_v2",
        "autoscale": {
          "min_workers": 2,
          "max_workers": 8
        },
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "spot_bid_max_price": -1
        },
        "spark_conf": {
          "spark.databricks.delta.autoOptimize.optimizeWrite": "true",
          "spark.databricks.delta.autoOptimize.autoCompact": "true"
        },
        "custom_tags": {
          "layer": "bronze",
          "pipeline": "medallion",
          "cost-center": "analytics"
        }
      },
      "retry_on_timeout": false,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver_transformation",
      "description": "Data cleansing, deduplication, and SCD2 merge into silver Delta tables",
      "depends_on": [
        {"task_key": "bronze_ingestion"}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/medallion-pipeline/notebooks/02_silver_transformation",
        "base_parameters": {
          "env": "{{env}}",
          "source_name": "orders"
        },
        "source": "WORKSPACE"
      },
      "new_cluster": {
        "cluster_name": "silver-cluster-{{env}}",
        "spark_version": "14.3.x-photon-scala2.12",
        "node_type_id": "Standard_DS4_v2",
        "autoscale": {
          "min_workers": 2,
          "max_workers": 10
        },
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "spot_bid_max_price": -1
        },
        "spark_conf": {
          "spark.databricks.delta.merge.enableLowShuffle": "true"
        },
        "custom_tags": {
          "layer": "silver",
          "pipeline": "medallion",
          "cost-center": "analytics"
        }
      },
      "retry_on_timeout": false,
      "max_retries": 1,
      "min_retry_interval_millis": 120000
    },
    {
      "task_key": "gold_aggregation_sales",
      "description": "Build daily_sales_summary gold table",
      "depends_on": [
        {"task_key": "silver_transformation"}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/medallion-pipeline/notebooks/03_gold_aggregation",
        "base_parameters": {
          "env": "{{env}}",
          "aggregation": "daily_sales_summary"
        },
        "source": "WORKSPACE"
      },
      "new_cluster": {
        "cluster_name": "gold-cluster-{{env}}",
        "spark_version": "14.3.x-photon-scala2.12",
        "node_type_id": "Standard_DS5_v2",
        "autoscale": {
          "min_workers": 2,
          "max_workers": 8
        },
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE"
        },
        "spark_conf": {
          "spark.sql.shuffle.partitions": "200",
          "spark.databricks.delta.optimizeWrite": "true"
        },
        "custom_tags": {
          "layer": "gold",
          "pipeline": "medallion",
          "cost-center": "analytics"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "gold_aggregation_customer360",
      "description": "Build customer_360 gold table",
      "depends_on": [
        {"task_key": "silver_transformation"}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/medallion-pipeline/notebooks/03_gold_aggregation",
        "base_parameters": {
          "env": "{{env}}",
          "aggregation": "customer_360"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "gold-cluster-{{env}}",
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "data_quality_checks",
      "description": "Cross-layer DQ validation — halts pipeline on critical failures",
      "depends_on": [
        {"task_key": "gold_aggregation_sales"},
        {"task_key": "gold_aggregation_customer360"}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/medallion-pipeline/notebooks/04_data_quality_checks",
        "base_parameters": {
          "env": "{{env}}",
          "source_name": "orders"
        },
        "source": "WORKSPACE"
      },
      "new_cluster": {
        "cluster_name": "dq-cluster-{{env}}",
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE"
        },
        "custom_tags": {
          "layer": "quality",
          "pipeline": "medallion"
        }
      },
      "max_retries": 0
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "env",
      "default": "prod"
    }
  ]
}
